# Production template. Copy to the private server-managed .env.production.
# Fill every required value before deployment; never commit a filled-in copy.

# Application mode and private signing key. Use production and DEBUG=False;
# generate a unique random SECRET_KEY for this environment.
DJANGO_ENV=
DEBUG=
SECRET_KEY=

# PostgreSQL connection. Use DJANGO_DB=postgres and a private DATABASE_URL
# containing the database name, credentials, host, and required TLS options.
DJANGO_DB=
DATABASE_URL=

# Public host and CSRF allowlists. ALLOWED_HOSTS uses comma-separated hostnames
# without schemes; CSRF_TRUSTED_ORIGINS uses full HTTPS origins.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Canonical public origin and indexing. SITE_URL must be an HTTPS origin without
# a trailing slash. Enable indexing only for the intended public production site.
SITE_URL=
SEARCH_ENGINE_INDEXING=

# HTTPS and browser policy. Enable the redirect and secure-cookie switches
# behind an HTTPS-ready proxy. Use same-origin for referrers. Set HSTS duration
# only after HTTPS works; enable subdomain/preload flags only when eligible.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_REFERRER_POLICY=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=

# Cloudinary media storage. All three values are required in production;
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET are private credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound email. Use django.core.mail.backends.smtp.EmailBackend with your
# provider's host, port, TLS setting, private credentials, and sender address.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Gunicorn listening port used by Docker and PM2; normally 8000.
PORT=
