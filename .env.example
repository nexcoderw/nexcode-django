# Variable-name template only: no runtime values or credentials.
# Copy to .env and fill the values using each comment before starting Django.
# Keep variable names synchronized whenever local or production configuration changes.

# Required mode: development or production. Production rejects DEBUG=True.
DJANGO_ENV=

# Set True locally or False in production. Never expose debug output publicly.
DEBUG=

# Required private Django signing key. Generate a unique random value per environment; never commit it.
SECRET_KEY=

# Database backend: postgres for deployments, sqlite for isolated local work.
DJANGO_DB=

# Private PostgreSQL connection URL, including credentials. Required for PostgreSQL deployments; blank for SQLite.
DATABASE_URL=

# Comma-separated allowed hostnames, without schemes. Use localhost,127.0.0.1 locally; explicit domains in production.
ALLOWED_HOSTS=

# Comma-separated trusted origins including scheme and port. Production origins must use HTTPS.
CSRF_TRUSTED_ORIGINS=

# Set True to store uploads in Cloudinary, otherwise False for local media storage.
USE_CLOUDINARY_MEDIA=

# Cloudinary account cloud name; required only when Cloudinary media is enabled.
CLOUDINARY_CLOUD_NAME=

# Private Cloudinary API key; required only when Cloudinary media is enabled.
CLOUDINARY_API_KEY=

# Private Cloudinary API secret; required only when Cloudinary media is enabled.
CLOUDINARY_API_SECRET=

# Required canonical HTTPS origin, such as https://nexcode.africa, without a path or trailing slash.
SITE_URL=

# Set True only for the public production site; False for local development and previews.
SEARCH_ENGINE_INDEXING=

# Redirect HTTP to HTTPS: False locally, True behind the production HTTPS proxy.
SECURE_SSL_REDIRECT=

# Send session cookies over HTTPS only: False locally, True in production.
SESSION_COOKIE_SECURE=

# Send CSRF cookies over HTTPS only: False locally, True in production.
CSRF_COOKIE_SECURE=

# Referrer policy; recommended value: same-origin.
SECURE_REFERRER_POLICY=

# HSTS duration in seconds: 0 locally; 31536000 only for an HTTPS-ready production host.
SECURE_HSTS_SECONDS=

# Set True only when every subdomain supports HTTPS; False locally.
SECURE_HSTS_INCLUDE_SUBDOMAINS=

# Set True only when intentionally meeting HSTS preload requirements; False locally.
SECURE_HSTS_PRELOAD=

# Gunicorn listening port used by Docker and PM2; normally 8000.
PORT=

# Email backend. Use the console backend locally and SMTP in production.
EMAIL_BACKEND=

# SMTP server hostname. Required when using the SMTP backend in production.
EMAIL_HOST=

# SMTP server port. Usually 587 when using TLS.
EMAIL_PORT=

# SMTP username when required by the provider.
EMAIL_HOST_USER=

# Private SMTP password. Never commit the real value.
EMAIL_HOST_PASSWORD=

# Use TLS for SMTP connections; normally True on port 587.
EMAIL_USE_TLS=

# Sender shown on administrator password-recovery emails.
DEFAULT_FROM_EMAIL=