# Local development template. Copy to .env, then fill the values you use.
# These assignments are intentionally blank; never commit a filled-in copy.

# Application mode and private signing key. Use development, True, and a unique
# random SECRET_KEY. Django requires SECRET_KEY even for local development.
DJANGO_ENV=
DEBUG=
SECRET_KEY=

# Local database. Use DJANGO_DB=sqlite for the bundled local database, or use
# postgres and provide a private PostgreSQL DATABASE_URL.
DJANGO_DB=
DATABASE_URL=

# Browser origins. List local hostnames without schemes in ALLOWED_HOSTS and
# full origins (with scheme and port) in CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Public metadata. SITE_URL must be an HTTPS origin without a trailing slash;
# keep SEARCH_ENGINE_INDEXING=False on local or preview sites.
SITE_URL=
SEARCH_ENGINE_INDEXING=

# Local transport security. Use False for the redirect and secure-cookie
# switches on plain HTTP; use 0 for HSTS and disable its subdomain/preload flags.
# SECURE_REFERRER_POLICY may use same-origin.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_REFERRER_POLICY=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=

# Local email. Use django.core.mail.backends.console.EmailBackend to print
# messages in the terminal, and set a harmless local sender address.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=

# Optional listening port for Docker or PM2; the default is 8000.
PORT=
